{
  "name": "monetizelab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,customer,admin -c blue,green,yellow \"pnpm dev:api\" \"pnpm dev:customer\" \"pnpm dev:admin\"",
    "dev:api": "pnpm --filter @monetizelab/api dev",
    "dev:customer": "pnpm --filter @monetizelab/customer-web dev",
    "dev:admin": "pnpm --filter @monetizelab/admin-web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @monetizelab/api prisma:generate",
    "db:push": "pnpm --filter @monetizelab/api prisma:push",
    "db:seed": "pnpm --filter @monetizelab/api prisma:seed",
    "db:reset": "pnpm --filter @monetizelab/api prisma:reset",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "concurrently": "9.2.1",
    "typescript": "5.9.3"
  }
}
